<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LogicCheck</AssemblyName>
    <RootNamespace>LogicCheck</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS0169;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="SimTests.cs" />
    <Compile Include="UnityStubs.cs" />
    <Compile Include="..\..\Assets\Scripts\Core\**\*.cs" />
    <Compile Include="..\..\Assets\Scripts\Gen\**\*.cs" />
    <Compile Include="..\..\Assets\Scripts\Sim\**\*.cs" />
  </ItemGroup>
</Project>