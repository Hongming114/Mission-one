<Project Sdk="Microsoft.NET.Sdk">

  <!--
    无 Unity 编译体检台架：
      * 用一整套 UnityEngine / UnityEngine.UI / UnityEngine.EventSystems / UnityEditor 桩，
      * 把 Assets\Scripts（Core / Gen / Sim / View / UI / Game）和 Assets\Editor 全部编一遍。
      * 目的：在没有 Unity 的环境里也能发现"少了 using / 名字写错 / 签名对不上"这类编译错误。
    用法：dotnet build Tools\CompileCheck\CompileCheck.csproj
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>CompileCheck</AssemblyName>
    <RootNamespace>CompileCheck</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS0108;CS0114;CS0618;CS0660;CS0661;CS0162</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="UnityStubs.cs" />
    <Compile Include="UnityUiStubs.cs" />
    <Compile Include="UnityEditorStubs.cs" />
    <Compile Include="..\..\Assets\Scripts\**\*.cs" />
    <Compile Include="..\..\Assets\Editor\**\*.cs" />
  </ItemGroup>

</Project>