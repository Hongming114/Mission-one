# 默认按文本处理，仓库内统一 LF 换行；二进制文件不做转换
* text=auto eol=lf

# Unity 的 YAML 资源按文本存储，便于 diff 与合并
*.unity text
*.prefab text
*.asset text
*.meta text
*.mat text
*.anim text
*.controller text
*.physicMaterial text

# 二进制资源
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.tga binary
*.fbx binary
*.obj binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.dll binary
*.so binary
*.exe binary
*.ttf binary
*.otf binary